<UserControl x:Class="OCITSAutoUpdate.SameProductLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OCITSAutoUpdate"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Loaded="UserControl_Loaded">
    <Grid>
        <ScrollViewer Grid.Row="1" x:Name="scrList" Margin="0" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="5" Name="stationColum1"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5" Name="stationColum2"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="5" Name="stationColum3"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="5" Name="stationColum4"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
