<UserControl x:Class="UIOperateInterleaver.OperateInterleaver"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UIOperateInterleaver"
             mc:Ignorable="d" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
             BorderThickness="2" BorderBrush="LightBlue" FontSize="13" PreviewKeyDown="OperateInterleaver_KeyDown" FontFamily="Arial,SimSun">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" Background="AliceBlue" BorderThickness="2">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="6*"/>
                    <!--ColumnDefinition Width="100"/-->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="20*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" VerticalAlignment="Stretch"  Grid.ColumnSpan="2">
                    <Label Content="SN:" Margin="2" VerticalAlignment="Center" />
                    <TextBox Name="txtBoxSN"  Height="30" Text="{Binding SN}" Margin="5,2,2,2" CharacterCasing="Upper" BorderBrush="#96CDCD" BorderThickness="2" />
                </DockPanel>
                <DockPanel Grid.Row="1" VerticalAlignment="Stretch" Grid.Column="2"  Grid.ColumnSpan="2">
                    <Label Content="归零时间:" Margin="2" VerticalAlignment="Center"/>
                    <TextBox Name="txtRefTime"  Height="30" Margin="0,2,2,2" CharacterCasing="Upper" BorderBrush="#96CDCD" BorderThickness="2" IsEnabled="False"/>
                </DockPanel>
                <DockPanel Grid.Row="0"  Grid.Column="2" VerticalAlignment="Stretch" Grid.ColumnSpan="2">
                    <Label Content="Spec#:" Margin="2" VerticalAlignment="Center"/>
                    <TextBox Name="txtSpec"  Height="30" Text="{Binding Spec}" Margin="0,2,2,2"  BorderBrush="#96CDCD" BorderThickness="2" IsReadOnly="True" IsEnabled="False"/>
                </DockPanel>
                <DockPanel Grid.Row="1"  VerticalAlignment="Stretch" Grid.Column="0"  Grid.ColumnSpan="2">
                    <Label Content="PN:" Margin="2" VerticalAlignment="Center"/>
                    <TextBox Name="txtPN"  Height="30" Margin="5,2,2,2"  BorderBrush="#96CDCD" Text="{Binding PN}" BorderThickness="2" IsReadOnly="True" IsEnabled="False"/>
                </DockPanel>
                <Button Grid.Row="2" Grid.Column="0" Name="btnOpenTemplate" Content="打开模板"  Margin="5" Click="btnOpenTemplate_Click" FontWeight="Black" FontSize="14"/>
                <Button Grid.Row="2" Grid.Column="2" Name="btnSaveToAMTS" Content="上传数据"  Margin="5"  IsEnabled="{Binding IsSaveEnable}" FontWeight="Black" FontSize="14" Click="btnSaveToAMTS_Click"/>
                <Button Grid.Row="2" Grid.Column="1" Name="btnUVata" Content="紫外光" IsEnabled="{Binding IsLightedEnable}" Margin="5" DockPanel.Dock="Left" FontWeight="Black" FontSize="14" Click="btnUVata_Click"/>

                <GroupBox Grid.Row="2" Grid.Column="3" Margin="0,3,0,0" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <RadioButton Name="chkPort12"  Content="Port1/2" IsChecked="{Binding IsPort12}" Checked="chkPort12_Checked"/>
                        <RadioButton Name="chkPort34" Content="Port3/4" IsChecked="{Binding IsPort34}" Checked="chkPort34_Checked"/>
                    </StackPanel>
                </GroupBox>
                <!--GroupBox Grid.Row="3" Grid.Column="3" Margin="0,0,0,3" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <RadioButton Name="chkNoPDL" Grid.Row="2" Grid.Column="3" Content="NOPDL" IsChecked="{Binding IsNoPDL}"/>
                        <RadioButton Name="chkPDL" Grid.Row="3" Grid.Column="3" Content="PDL" IsChecked="{Binding IsPDL}"/>
                    </StackPanel>
                </-->
                <Button Name="btnAdjustScan" Grid.Row="3"  Grid.Column="1" Content="调节"  Margin="5"  DockPanel.Dock="Left" IsEnabled="{Binding IsAdjustScanEnable}"  Visibility="{Binding IsAdjustScanVisible}" VerticalAlignment="Stretch" Click="btnAdjustScan_Click" FontWeight="Black" FontSize="14"/>
                <Button Name="btnStopScan" Grid.Row="3"  Grid.Column="1" Content="停止"   Margin="5" DockPanel.Dock="Left" Visibility="{Binding IsStopScanVisible}" Click="btnStopScan_Click" VerticalAlignment="Stretch" FontWeight="Black" FontSize="14"/>
                <Button Name="btnScanRef" Grid.Row="3"  Grid.Column="0" Content="系统归零"   Margin="5"  DockPanel.Dock="Left" IsEnabled="{Binding IsEnable}" VerticalAlignment="Stretch" Click="btnScanRef_Click" FontWeight="Black" FontSize="14"/>
                <Button Name="btnPDLScan" Grid.Row="3"  Grid.Column="2" Content="测试"   Margin="5" DockPanel.Dock="Left" IsEnabled="{Binding IsEnable}" Click="btnPDLScan_Click" VerticalAlignment="Stretch" FontWeight="Black" FontSize="14"/>
                <Label Content="测试结果：" Grid.Row="3"  Grid.Column="3" FontWeight="Black" FontSize="14" VerticalAlignment="Bottom"/>
                <Image Name="passOrFailImg" Grid.Row="4"  Grid.Column="3"  Loaded="PassOrFail_Load" Source="/image/pass.ico" Margin="3"/>
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,10,0,0" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                        <TextBlock Text="功率计归零" Margin="0,0,0,5"/>
                        <TextBlock Text="系统归零"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,3,7,0">
                        <Ellipse Width="13" Name="ref18301" Height="13" Fill="Red" Margin="0,0,0,10"/>
                        <Ellipse Width="13" Name="refSys1" Height="13" Fill="Red" Margin="0,0,0,5"/>
                        <TextBlock Text="port1"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,3,7,0">
                        <Ellipse Width="13" Name="ref18302" Height="13" Fill="Red" Margin="0,0,0,10"/>
                        <Ellipse Width="13" Name="refSys2" Height="13" Fill="Red" Margin="0,0,0,5"/>
                        <TextBlock Text="port2"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,3,7,0">
                        <Ellipse Width="13" Name="ref18303" Height="13" Fill="Red" Margin="0,0,0,10"/>
                        <Ellipse Width="13" Name="refSys3" Height="13" Fill="Red" Margin="0,0,0,5"/>
                        <TextBlock Text="port3"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,3,7,0">
                        <Ellipse Name="ref18304" Width="13" Height="13" Fill="Red" Margin="0,0,0,10"/>
                        <Ellipse Name="refSys4" Width="13" Height="13" Fill="Red" Margin="0,0,0,5"/>
                        <TextBlock Text="port4"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Column="1" Background="AliceBlue" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>
                <Label Content="MIN ISO-1:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                <Label Content="191300-Shift:" Name="PM1LowFre" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                <Label Content="193600-Shift:" Name="PM1MidFre" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                <Label Content="196000-Shift:" Name="PM1HighFre" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
                <Label Content="FSR-1:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0"/>

                <TextBox Name="PM1MinIso" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2,10,3,10" TextAlignment="Center" FontSize="20"/>
                <TextBox Name="PM1LowFreShift"  Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2,10,3,10" TextAlignment="Center" FontSize="20"/>
                <TextBox Name="PM1MidFreShift"  Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2,10,3,10" FontSize="20" TextAlignment="Center"/>
                <TextBox Name="PM1HighFreShift" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2,10,3,10" TextAlignment="Center" FontSize="20"/>
                <TextBox Name="PM1FSR" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2,10,3,10" FontSize="20"/>

                <Label Content="MIN ISO-2:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2"/>
                <Label Content="191350-Shift:" Name="PM2LowFre" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2"/>
                <Label Content="193650-Shift:" Name="PM2MidFre" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="2" Grid.Column="2"/>
                <Label Content="196500-Shift:" Name="PM2HighFre" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="3" Grid.Column="2"/>
                <Label Content="FSR-2:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="4" Grid.Column="2"/>

                <TextBox Name="PM2MinIso" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" Margin="2,10,3,10" FontSize="20"/>
                <TextBox Name="PM2LowFreShift" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" Margin="2,10,3,10" FontSize="20"/>
                <TextBox Name="PM2MidFreShift" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Stretch" Margin="2,10,3,10" FontSize="20"/>
                <TextBox Name="PM2HighFreShift" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Stretch" Margin="2,10,3,10" FontSize="20"/>
                <TextBox Name="PM2FSR" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Stretch" Margin="2,10,3,10" FontSize="20"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
