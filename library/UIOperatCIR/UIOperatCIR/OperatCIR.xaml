<UserControl x:Class="UIOperatCIR.OperatCIR"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UIOperatCIR"
             mc:Ignorable="d" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
             d:DesignHeight="200" d:DesignWidth="300" PreviewKeyDown="OperateInterleaver_KeyDown" >
    <Grid>
        <GroupBox Background="AliceBlue" BorderThickness="2">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="6*"/>
                    <!--ColumnDefinition Width="100"/-->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" VerticalAlignment="Stretch"  Grid.ColumnSpan="2">
                    <Label Content="SN:" Margin="2" VerticalAlignment="Center" />
                    <TextBox Name="txtBoxSN" Text="{Binding SN}" Height="30" Margin="5,2,2,2" CharacterCasing="Upper" BorderBrush="#96CDCD" BorderThickness="2" />
                </DockPanel>
                <DockPanel Grid.Row="1" VerticalAlignment="Stretch" Grid.Column="2"  Grid.ColumnSpan="2">
                    <Label Content="归零时间:" Margin="2" VerticalAlignment="Center"/>
                    <TextBox Name="txtRefTime"  Height="30" Margin="0,2,2,2" CharacterCasing="Upper" BorderBrush="#96CDCD" BorderThickness="2" IsEnabled="False"/>
                </DockPanel>
                <DockPanel Grid.Row="0"  Grid.Column="2" VerticalAlignment="Stretch" Grid.ColumnSpan="2">
                    <Label Content="Spec#:" Margin="2" VerticalAlignment="Center"/>
                    <TextBox Name="txtSpec" Text="{Binding Spec}" Height="30" Margin="0,2,2,2"  BorderBrush="#96CDCD" BorderThickness="2" IsReadOnly="True" IsEnabled="False"/>
                </DockPanel>
                <DockPanel Grid.Row="1"  VerticalAlignment="Stretch" Grid.Column="0"  Grid.ColumnSpan="2">
                    <Label Content="PN:" Margin="2" VerticalAlignment="Center"/>
                    <TextBox Name="txtPN" Text="{Binding PN}" Height="30" Margin="5,2,2,2"  BorderBrush="#96CDCD"  BorderThickness="2" IsReadOnly="True" IsEnabled="False"/>
                </DockPanel>
                <Button Grid.Row="2" Grid.Column="0" Name="btnOpenTemplate" Content="打开模板"  Margin="5"  FontWeight="Black" FontSize="14" Click="btnOpenTemplate_Click"/>
                <Button Grid.Row="2" Grid.Column="1" Name="btnSaveToAMTS" IsEnabled="{Binding IsEnable}" Click="btnSaveToAMTS_Click" Content="上传数据"  Margin="5"   FontWeight="Black" FontSize="14" />
                <Button Grid.Row="2" Grid.Column="2"  Name="btnPMReset" IsEnabled="{Binding IsEnable}" Content="功率计复位"  Margin="5" DockPanel.Dock="Left" FontWeight="Black" FontSize="14" Click="btnPMReset_Click" />
                <Button Name="btnStopOnekey" Visibility="{Binding IsStopScanVisible}" Click="btnStopOnekey_Click" Grid.Row="3"  Grid.Column="1" Content="停止"  Margin="5"  DockPanel.Dock="Left"  VerticalAlignment="Stretch"  FontWeight="Black" FontSize="14"/>
                <Button Name="btnOnekey" IsEnabled="{Binding IsEnable}" Visibility="{Binding IsOnekeyVisible}" Click="btnOnekey_Click" Grid.Row="3"  Grid.Column="1" Content="一键测试"   Margin="5" DockPanel.Dock="Left"   VerticalAlignment="Stretch" FontWeight="Black" FontSize="14"/>
                <Button Name="btnScanRef" IsEnabled="{Binding IsEnable}" Grid.Row="3"  Grid.Column="0" Content="归零" Click="btnScanRef_Click"  Margin="5"  DockPanel.Dock="Left"  VerticalAlignment="Stretch"  FontWeight="Black" FontSize="14"/>
                <Button Name="btnSingleTest" Click="btnSingleTest_Click" IsEnabled="{Binding IsEnable}" Grid.Row="3"  Grid.Column="2" Content="单项测试"   Margin="5" DockPanel.Dock="Left"   VerticalAlignment="Stretch" FontWeight="Black" FontSize="14"/>
                <Label Content="测试结果：" Grid.Row="3"  Grid.Column="3" FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                <Image Name="passOrFailImg" Grid.Row="2"  Grid.Column="3"  Source="/image/pass.ico" Margin="3" Loaded="PassOrFail_Load"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
