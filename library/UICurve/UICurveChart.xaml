<UserControl x:Class="UICurve.UICurveChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UICurve"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded" BorderThickness="2" BorderBrush="LightBlue" FontFamily="Arial,SimSun">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Name="curveSelect" HorizontalAlignment="Left">
            <TextBox Name="statusLabel"/>
        </DockPanel>
        <WindowsFormsHost Name="chartHost" Grid.Row="1"/>
    </Grid>
</UserControl>
