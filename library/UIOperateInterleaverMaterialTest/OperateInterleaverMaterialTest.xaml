<UserControl x:Class="UIOperateInterleaverMaterialTest.OperateInterleaverMaterialTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UIOperateInterleaverMaterialTest"
             mc:Ignorable="d" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded" Background="AliceBlue"
             BorderThickness="2" BorderBrush="LightBlue" FontSize="13" FontFamily="Arial,SimSun">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
            <Label Content="SN:" Margin="2" VerticalAlignment="Center" />
            <TextBox Name="txtBoxSN" Height="30" MinWidth="80" Text="{Binding SN}" Margin="5,2,2,2" CharacterCasing="Upper" BorderBrush="#96CDCD" BorderThickness="2" />
            <Label  Content="归零时间:" Margin="2" VerticalAlignment="Center"/>
            <TextBox Name="txtRefTime" Height="30" MinWidth="80" Margin="0,2,2,2" CharacterCasing="Upper" BorderBrush="#96CDCD" BorderThickness="2" IsEnabled="False"/>
        </StackPanel> 
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
            <Label Content="文件:" Margin="2" VerticalAlignment="Center"></Label>
            <TextBox Name="txt_path" Height="30" Margin="5" Text="{Binding Path}" BorderBrush="#96CDCD"  BorderThickness="2" Width="200"></TextBox>
            <Button x:Name="btn_Scan" VerticalContentAlignment="Center" Width="30" Margin="5" HorizontalAlignment="Right" Click="btn_Scan_Click">...</Button>
        </StackPanel>
        <!--<Button Grid.Row="2" Grid.Column="0" Name="btnOpenTemplate" Content="打开模板"  Margin="5" Click="btnOpenTemplate_Click" FontWeight="Black" FontSize="14"/>-->
        <Button Name="btnScanRef" Grid.Row="2" Grid.Column="0" Content="系统归零" Height="30"  Margin="5"  DockPanel.Dock="Left" IsEnabled="{Binding IsEnable}" VerticalAlignment="Stretch" Click="btnScanRef_Click" FontWeight="Black" FontSize="14"/>
        <Button Name="btnAdjustScan" Grid.Row="2" Grid.Column="1" Content="调节" Height="30"  Margin="5"  DockPanel.Dock="Left" IsEnabled="{Binding IsAdjustScanEnable}"  Visibility="{Binding IsAdjustScanVisible}" VerticalAlignment="Stretch" Click="btnAdjustScan_Click" FontWeight="Black" FontSize="14"/>
       <!-- <Button Name="btnStopScan" Grid.Row="2" Grid.Column="1" Content="停止"  Height="30"  Margin="5" DockPanel.Dock="Left" Visibility="{Binding IsStopScanVisible}" Click="btnStopScan_Click" VerticalAlignment="Stretch" FontWeight="Black" FontSize="14"/>-->

            <Label Content="MaxIL:" Grid.Row="3" Grid.Column="0" Margin="2" VerticalAlignment="Center" />
            <TextBox Name="txt_MaxIL" Grid.Row="3" Grid.Column="1" Text="{Binding Max}" Height="30" MinWidth="80"  Margin="5,2,2,2" BorderBrush="#96CDCD" BorderThickness="2" IsReadOnly="True" />
            <Label Content="MinIL:" Grid.Row="3" Grid.Column="2" Margin="2" VerticalAlignment="Center" />
        <TextBox Name="txt_MinIL" Grid.Row="3" Grid.Column="3" Text="{Binding Min}" Height="30"  MinWidth="80" Margin="5,2,2,2" BorderBrush="#96CDCD" BorderThickness="2" IsReadOnly="True" />
        <Label Content="Differ:" Grid.Row="4" Grid.Column="0" Margin="2" VerticalAlignment="Center" />
        <TextBox Name="txt_Differ" Grid.Row="4" Grid.Column="1" Text="{Binding Differ}" Height="30"  MinWidth="80" Margin="5,2,2,2" BorderBrush="#96CDCD" BorderThickness="2" IsReadOnly="True" />
        <ListBox x:Name="lst_Msg" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Width="300" HorizontalAlignment="Left" Margin="5" ScrollViewer.VerticalScrollBarVisibility="Auto"></ListBox>
    </Grid>
</UserControl>
